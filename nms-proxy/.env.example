# --- Koneksi ke NMS ---
NMS_BASE_URL=https://nms2-sandbox.xenoptics.co/api/v2
NMS_USERNAME=Admin
NMS_PASSWORD=Admin
# NMS_LOGIN_MODE=readonly

# --- Keamanan proxy (wajib diisi, generate string acak yang panjang) ---
PROXY_API_KEY=ganti-dengan-string-rahasia-yang-panjang

# --- CORS: origin dashboard yang boleh mengakses proxy ini ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Cache GET (detik) ---
CACHE_TTL_SECONDS=5

# --- Endpoint controlling (connect/disconnect) ---
# Biarkan false sampai Fase 3 benar-benar siap diuji.
ENABLE_CONTROL_ENDPOINTS=false
